PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=0
NODE_ENV=development

# MongoDB Atlas (from atlas-credentials.env, or paste here)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ouija?retryWrites=true&w=majority
MONGODB_DB=ouija
# Optional — only needed if you prefer separate fields over MONGODB_URI
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
